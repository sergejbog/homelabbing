# Normally provisioned automatically at deploy time by
# fetch-secrets-pre-deploy.sh: Infisical root (/) supplies DOMAIN_NAME and
# LETSENCRYPT_EMAIL, /traefik-edge supplies BASIC_AUTH, and the stack's
# pre_deploy in main.toml appends EDGE_NAME. Only fill this file in manually
# if bootstrapping without Komodo.
DOMAIN_NAME=your-domain.com
LETSENCRYPT_EMAIL=you@example.com
# htpasswd-format user:hash for the dashboard (generate: htpasswd -nB admin)
BASIC_AUTH=admin:your-htpasswd-hash
# Short server slug; the dashboard becomes traefik-<EDGE_NAME>.<DOMAIN_NAME>
EDGE_NAME=myserver

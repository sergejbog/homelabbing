INFISICAL_CLIENT_ID="your-infisical-client-id"
INFISICAL_CLIENT_SECRET="your-infisical-client-secret"
INFISICAL_API_URL="https://secrets.your-domain.com/api"
INFISICAL_PROJECT_ID="your-infisical-project-id"

APPRISE_URL=https://apprise.your-domain.com
APPRISE_CONFIG=apprise
APPRISE_LOGIN='admin:your-apprise-password'

NTFY_URL="https://ntfy.your-domain.com"
NTFY_LOGIN='admin:password'

RESTIC_REPOSITORY="rest:https://backups:password@restic.your-domain.com/"
RESTIC_PASSWORD="your-restic-repository-password"
B2_ACCOUNT_ID="your-b2-account-id"
B2_ACCOUNT_KEY="your-b2-account-key"

# Offsite replica repository — new snapshots are copied here by 'sync-offsite'
# after each Backup-All run. Leave empty to disable offsite sync.
RESTIC_REPOSITORY_OFFSITE="b2:your-b2-bucket-name:/restic"
RESTIC_REPOSITORY_OFFSITE2=""
# Password for the offsite repo. Defaults to RESTIC_PASSWORD if empty.
RESTIC_PASSWORD_OFFSITE=""

# Uptime Kuma push monitor URL (dead man's switch) — pinged on every
# successful service backup. Leave empty to disable.
# Use the bare push URL without query parameters, e.g. https://kuma.your-domain.com/api/push/AbCdEf1234
BACKUP_PUSH_URL=""

# Komodo API — lets backup-manager.sh finish a restore with a real Komodo
# stack redeploy instead of a bare 'docker compose up -d'. Create the key
# pair in Komodo under Settings → Api Keys. Leave empty to disable.
KOMODO_URL="https://komodo.your-domain.com"
KOMODO_API_KEY="your-komodo-api-key"
KOMODO_API_SECRET="your-komodo-api-secret"
